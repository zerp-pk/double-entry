{
    "name": "zerp/double-entry",
    "description": "Double-entry bookkeeping module for the Zerp ERP platform",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0 || ^10.0"
    },
    "autoload": {
        "psr-4": {
            "Zerp\\DoubleEntry\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zerp\\DoubleEntry\\Tests\\": "tests/"
        },
        "files": [
            "tests/helpers.php"
        ]
    },
    "scripts": {
        "test": "phpunit"
    },
    "authors": [
        {
            "name": "ZAWAT OFFICIALS PVT LTD",
            "email": "zawatofficials@gmail.com"
        },
        {
            "name": "HafizMMoaz",
            "email": "hafizmoazkhalid@gmail.com"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "Zerp\\DoubleEntry\\Providers\\DoubleEntryServiceProvider"
            ]
        }
    }
}
